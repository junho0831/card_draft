# Godot 4+ specific ignores
.godot/
/android/
/build/*
!/build/.gdignore

# Local Fastlane output and Bundler configuration
/.bundle/
/vendor/bundle/
/fastlane/report.xml

# Local editor settings
.idea/
docs/.idea/

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/
