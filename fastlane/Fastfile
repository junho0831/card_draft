default_platform(:android)

platform :android do
  desc "Upload a verified Card Draft AAB to a Google Play test track"
  lane :deploy_test do
    track = ENV.fetch("PLAY_TRACK", "alpha")
    UI.user_error!("Only alpha and internal tracks are allowed") unless %w[alpha internal].include?(track)

    aab = ENV.fetch("PLAY_AAB_PATH", "")
    key = ENV.fetch("PLAY_JSON_KEY_PATH", "")
    metadata = ENV.fetch("PLAY_METADATA_PATH", "")
    release_name = ENV.fetch("PLAY_RELEASE_NAME", "")

    UI.user_error!("Set PLAY_AAB_PATH to the verified AAB") unless File.file?(aab) && File.size?(aab)
    UI.user_error!("Set PLAY_JSON_KEY_PATH to the Play service account key") unless File.file?(key) && File.size?(key)
    UI.user_error!("Set PLAY_METADATA_PATH to the release notes directory") unless File.directory?(metadata)
    UI.user_error!("Set PLAY_RELEASE_NAME") if release_name.empty?

    upload_to_play_store(
      package_name: "com.card_draft",
      track: track,
      aab: File.expand_path(aab),
      json_key: File.expand_path(key),
      metadata_path: File.expand_path(metadata),
      version_name: release_name,
      release_status: "completed",
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: false,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      changes_not_sent_for_review: false,
      rescue_changes_not_sent_for_review: false
    )
  end
end
